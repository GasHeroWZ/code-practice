# 统一换行符处理，消除 "LF will be replaced by CRLF" 警告
* text=auto

# 源码与文档按文本处理
*.c    text
*.h    text
*.md   text
*.json text

# PowerShell 脚本在 Windows 上用 CRLF
*.ps1  text eol=crlf
# Shell 脚本必须在 Linux 上用 LF，否则报 bad interpreter: /bin/bash^M
*.sh   text eol=lf

# 二进制文件不要做换行转换
*.exe  binary
*.o    binary
*.a    binary
*.lib  binary